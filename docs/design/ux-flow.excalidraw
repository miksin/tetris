    },
    {
      "type": "text",
      "id": "t-controls-right",
      "x": 510,
      "y": 555,
      "width": 380,
      "height": 130,
      "text": "P — Pause / Resume\nSPACE (idle) — Start game\nSPACE (game over) — Restart\nESC — Force pause\nR — Restart (from pause)",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#495057",
      "originalText": "P — Pause / Resume\nSPACE (idle) — Start game\nSPACE (game over) — Restart\nESC — Force pause\nR — Restart (from pause)",
