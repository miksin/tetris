      "x": 100,
      "y": 555,
      "width": 380,
      "height": 130,
      "text": "LEFT / RIGHT — Move piece\nDOWN — Soft drop (faster fall)\nSPACE — Hard drop (instant)\nZ / UP — Rotate\nC — Hold piece",
      "fontSize": 18,
      "fontFamily": 1,
      "strokeColor": "#495057",
      "originalText": "LEFT / RIGHT — Move piece\nDOWN — Soft drop (faster fall)\nSPACE — Hard drop (instant)\nZ / UP — Rotate\nC — Hold piece",
